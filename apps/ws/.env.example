# Copy to .env and adjust if needed.

# Same database as apps/api.
DATABASE_URL=postgres://matiks:matiks@127.0.0.1:55432/matiks

# Raw WebSocket listener. The client reaches it through NEXT_PUBLIC_WS_URL.
WS_PORT=4001

# Browser origin allowed to open a socket.
CORS_ORIGIN=http://localhost:3000

# Cross-origin is not involved, but matchmaking uses the same grace window as
# the API. Keep the values in step with apps/api/.env.
BOT_ELIGIBLE_MS=6000
