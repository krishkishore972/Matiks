# Copy to .env and adjust if needed.

# Matches docker-compose.yml (host port 55432 so an existing local Postgres on
# 5432 is left alone). The HTTP API and the WS game server share this database.
DATABASE_URL=postgres://matiks:matiks@127.0.0.1:55432/matiks

# HTTP API listener. The live game server is apps/ws (WS_PORT=4001).
PORT=4000

# How long matchmaking waits before an AlphaBot may fill the seat. The shipped
# app exposes exactly this as `botEligibleAtMs` on searchOpponentV3 / pollSearchV3.
BOT_ELIGIBLE_MS=6000

# Origin allowed to call the API from a browser (the Next dev server / build).
CORS_ORIGIN=http://localhost:3000
