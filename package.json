{
  "name": "maticks",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:ws": "pnpm --filter @repo/ws dev",
    "db:up": "pnpm --filter api db:up",
    "db:down": "pnpm --filter api db:down",
    "db:migrate": "pnpm --filter api migrate",
    "db:generate": "pnpm --filter api db:generate",
    "db:reset": "pnpm --filter api db:reset",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
